[Error]
interface DashError {
  Internal(string message);
};

dictionary Addresses {
  string shielded_address;
};

dictionary Transaction {
  string txid;
  i64 block_time_in_seconds;
  i64 mined_height;
  string value;
  string? fee;
  string? to_address;
  sequence<string> memos;
};

dictionary CoreBalance {
  string confirmed_duffs;
  string unconfirmed_duffs;
  string total_duffs;
  u32 synced_height;
};

dictionary AssetLock {
  string txid;
  u32 vout;
  string status;
};

dictionary Poll {
  string alias;
  string status;
  f64 scan_progress;
  u32 network_block_height;
  string available_credits;
  string total_credits;
  sequence<Transaction> transactions;
};

namespace dash {
  [Throws=DashError]
  void set_document_directory(string path);

  [Throws=DashError]
  void initialize(
    string mnemonic_seed,
    u32 account,
    string alias,
    string network_name,
    string default_host,
    u32 default_port
  );

  [Throws=DashError]
  string stop(string alias);

  [Throws=DashError]
  void start_sync(string alias);

  [Throws=DashError]
  void stop_sync(string alias);

  [Throws=DashError]
  Addresses derive_shielded_address(string alias);

  [Throws=DashError]
  string core_receive_address(string alias, u32 account);

  [Throws=DashError]
  void start_core_sync(string alias, u32 from_height);

  [Throws=DashError]
  CoreBalance core_balance(string alias);

  [Throws=DashError]
  string shield_from_asset_lock(
    string alias,
    string amount_duffs,
    u32 account_index,
    string mnemonic_seed
  );

  [Throws=DashError]
  string platform_receive_address(string alias, u32 account);

  [Throws=DashError]
  sequence<AssetLock> tracked_asset_locks(string alias);

  [Throws=DashError]
  string resume_shield_from_asset_lock(
    string alias,
    string txid,
    u32 vout,
    string mnemonic_seed
  );

  [Throws=DashError]
  string unshield(
    string alias,
    string to_address,
    string amount_credits,
    string mnemonic_seed
  );

  [Throws=DashError]
  string shielded_withdraw(
    string alias,
    string to_core_address,
    string amount_credits,
    u32 core_fee_per_byte,
    string mnemonic_seed
  );

  boolean is_valid_address(string address, string network);

  [Throws=DashError]
  string derive_viewing_key(string mnemonic_seed, string network);

  [Throws=DashError]
  void warm_up_prover();

  boolean is_prover_ready();

  [Throws=DashError]
  Poll poll(string alias);

  [Throws=DashError]
  string propose_transfer(
    string alias,
    string amount_credits,
    string to_address,
    string? memo
  );

  [Throws=DashError]
  string create_transfer(
    string alias,
    string proposal_id,
    string mnemonic_seed
  );

  [Throws=DashError]
  string derive_shielded_address_from_seed(
    string mnemonic_seed,
    string network,
    u32 account
  );
};
